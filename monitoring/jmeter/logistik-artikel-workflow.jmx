def idx = vars.get("itemIdx")
def itemId = vars.get("itemId_" + idx)
vars.put("currentItemId", itemId)

def qtyStr = vars.get("itemActualQty_" + idx)
def qty = (qtyStr != null &amp;&amp; qtyStr != "") ? Integer.parseInt(qtyStr) : 1

def rand = (int)(Math.random() * 10) + 1
if (rand == 1 &amp;&amp; qty > 1) {
