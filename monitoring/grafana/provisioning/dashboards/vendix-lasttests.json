        "tooltip": {
          "hideZeros": false,
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vendix-prometheus"
          },
          "editorMode": "code",
          "expr": "(\n  sum(rate(http_server_requests_seconds_sum{uri=\"/api/receipt\"}[1m]))\n  /\n  clamp_min(sum(rate(http_server_requests_seconds_count{uri=\"/api/receipt\"}[1m])), 0.000001)\n) * 1000",
          "legendFormat": "Receipt",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Response Time (avg ms)",
      "type": "timeseries"
    },
