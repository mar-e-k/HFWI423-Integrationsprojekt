      <!--
        ┌─────────────────────────────────────────────────────────────┐
        │  3. SPIKE-TEST – Reaktion auf plötzliche Lastspitze         │
        │  Ziel: Erholt sich das System nach einem abrupten Ansturm?  │
        │                                                             │
        │  num_threads  = 100    ← Anzahl User beim Spike             │
        │  ramp_time    = 5      ← Sekunden bis alle User aktiv sind  │
        │                          (bewusst sehr kurz = harter Spike) │
