        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/receipt (Kaufabschluss)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/receipt</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
