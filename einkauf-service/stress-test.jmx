            <stringProp name="DurationAssertion.duration">${__P(slaOrderMs,3000)}</stringProp>
          </DurationAssertion>
          <hashTree/>
        </hashTree>
      </hashTree>

      <!-- ============================ STAGE 2 ============================= -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stage 2 - Normal (+150)" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(users2,150)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(ramp2,60)}</stringProp>
