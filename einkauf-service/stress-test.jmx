      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Stage 3 - Heavy (+300)" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${__P(users3,300)}</stringProp>
