<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter-parent -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>de.fhdw.vendix</groupId>
    <artifactId>vendix-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>vendix-parent</name>
    <description>vendix-parent</description>

    <modules>
        <module>commons</module>
        <module>pos</module>
        <module>store</module>
        <module>orchestrator</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Module Versions -->
        <commons.version>1.0.0</commons.version>
        <store.version>1.0.0</store.version>
        <pos.version>1.0.0</pos.version>
        <!-- Dependency Versions -->
        <vaadin.version>25.1.4</vaadin.version>
        <spring-cloud.version>2025.1.1</spring-cloud.version>
        <swagger.version>2.2.49</swagger.version>
        <springdoc.version>3.0.3</springdoc.version>
        <redison.version>4.3.1</redison.version>
        <plaguv-amqp.version>1.3.0</plaguv-amqp.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <loki-logback.version>2.0.3</loki-logback.version>
        <pdfbox.version>3.0.6</pdfbox.version>
        <!-- Plugin Versions -->
        <springdoc-maven.version>1.5</springdoc-maven.version>
        <error-prone.version>2.49.0</error-prone.version>
        <error-prone-support.version>0.29.0</error-prone-support.version>
        <nullaway.version>0.13.4</nullaway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Source: https://mvnrepository.com/artifact/com.vaadin/vaadin-bom -->
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/org.springframework.cloud/spring-cloud-dependencies -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.swagger.core.v3/swagger-bom -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-bom</artifactId>
                <version>${swagger.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-bom -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/org.redisson/redisson-spring-boot-starter -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redison.version}</version>
                <scope>compile</scope>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/io.github.plaguv/plaguv-amqp-spring-boot-starter -->
            <dependency>
                <groupId>io.github.plaguv</groupId>
                <artifactId>plaguv-amqp-spring-boot-starter</artifactId>
                <version>${plaguv-amqp.version}</version>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/org.mapstruct/mapstruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/com.github.loki4j/loki-logback-appender -->
            <dependency>
                <groupId>com.github.loki4j</groupId>
                <artifactId>loki-logback-appender</artifactId>
                <version>${loki-logback.version}</version>
            </dependency>
            <!-- Source: https://mvnrepository.com/artifact/org.apache.pdfbox/pdfbox -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Source: https://mvnrepository.com/artifact/org.springdoc/springdoc-openapi-maven-plugin -->
                <plugin>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-maven-plugin</artifactId>
                    <version>${springdoc-maven.version}</version>
                </plugin>
                <!-- Source: https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-compiler-plugin -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <compilerArgs>
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                            <arg> <!-- Arguments have to be appending for ErrorProne-->
                                -Xplugin:ErrorProne
                                -XepOpt:NullAway:AnnotatedPackages=de.fhdw.vendix
                                -XepOpt:NullAway:ExcludedClassAnnotations=jakarta.persistence.Entity,jakarta.persistence.MappedSuperclass
                                -XepOpt:NullAway:TreatGeneratedAsUnannotated=true
                                -XepDisableWarningsInGeneratedCode
                                -Xep:NullAway:ERROR
                                -Xep:StaticImport:OFF
                            </arg>
                        </compilerArgs>
                        <annotationProcessorPaths>
                            <!-- Source: https://mvnrepository.com/artifact/com.google.errorprone/error_prone_core -->
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${error-prone.version}</version>
                            </path>
                            <!-- Source: https://mvnrepository.com/artifact/tech.picnic.error-prone-support/error-prone-contrib -->
                            <path>
                                <groupId>tech.picnic.error-prone-support</groupId>
                                <artifactId>error-prone-contrib</artifactId>
                                <version>${error-prone-support.version}</version>
                            </path>
                            <!-- Source: https://mvnrepository.com/artifact/com.uber.nullaway/nullaway -->
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>
                            <!-- Source: https://mvnrepository.com/artifact/org.mapstruct/mapstruct-processor -->
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>