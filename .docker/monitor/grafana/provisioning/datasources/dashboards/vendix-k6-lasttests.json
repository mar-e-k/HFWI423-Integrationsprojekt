          "expr": "(\n  sum(rate(http_server_requests_seconds_sum{application=\"store\", uri!~\"/actuator.*\"}[1m]))\n/ clamp_min(sum(rate(http_server_requests_seconds_count{application=\"store\", uri!~\"/actuator.*\"}[1m])), 0.001)\n) * 1000 or on() vector(0)",
