  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "\ud83d\udcc8 Log-Statistiken (letzte 5 min)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false
