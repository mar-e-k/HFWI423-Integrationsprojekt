    {
      "id": 2,
      "type": "stat",
      "title": "ERROR \u2013 alle",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "vendix-loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "vendix-loki"
          },
          "expr": "sum(count_over_time({app=\"vendix\"} |= \"ERROR\" [5m])) or on() vector(0)",
          "refId": "A",
          "legendFormat": ""
        }
      ]
    },
