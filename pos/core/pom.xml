<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.fhdw.vendix</groupId>
        <artifactId>pos-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>pos-core</artifactId>
    <packaging>jar</packaging>

    <name>pos-core</name>
    <description>pos-core</description>

    <dependencies>
        <dependency>
            <groupId>de.fhdw.vendix</groupId>
            <artifactId>pos-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>client</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${maven.multiModuleProjectDirectory}/commons/api/src/main/resources/openapi.yaml</inputSpec>
                            <output>${project.build.directory}/generated-sources/openapi</output>
                            <ignoreFileOverride>${maven.multiModuleProjectDirectory}/commons/api/src/main/resources/.openapi-generator-ignore</ignoreFileOverride>
                            <generatorName>spring</generatorName>
                            <importMappings>
                                <importMapping>AccountDTO=de.fhdw.vendix.commons.api.domain.account.AccountDTO</importMapping>
                                <importMapping>LockDTO=de.fhdw.vendix.commons.api.domain.lock.LockDTO</importMapping>
                            </importMappings>
                            <configOptions>
                                <library>spring-http-interface</library>
                                <openApiNullable>false</openApiNullable>
                                <useSpringBoot4>true</useSpringBoot4>
                                <useJakartaEe>true</useJakartaEe>
                            </configOptions>
                            <apiPackage>${project.groupId}.client.api</apiPackage>
                            <modelPackage>${project.groupId}.client.model</modelPackage>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>